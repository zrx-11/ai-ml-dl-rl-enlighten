  "glossary": [
    {
      "term": "理性智能体",
      "def": "在给定感知与目标下选择能最大化期望性能的动作的智能体。",
      "chapterId": "ch01"
    },
    {
      "term": "性能度量",
      "def": "评价智能体行为好坏的外部标准。",
      "chapterId": "ch01"
    },
    {
      "term": "感知序列",
      "def": "智能体从开始到当前收到的全部感知输入。",
      "chapterId": "ch01"
    },
    {
      "term": "PEAS",
      "def": "描述任务的四要素：性能度量、环境、执行器、传感器。",
      "chapterId": "ch02"
    },
    {
      "term": "基于模型的反射智能体",
      "def": "维护内部状态以应对部分可观测环境的智能体。",
      "chapterId": "ch02"
    },
    {
      "term": "效用函数",
      "def": "在多个目标冲突时衡量整体偏好程度的函数。",
      "chapterId": "ch02"
    },
    {
      "term": "状态空间",
      "def": "由所有可达状态与转移构成的问题表示。",
      "chapterId": "ch03"
    },
    {
      "term": "启发函数",
      "def": "估计从某节点到目标剩余代价的函数。",
      "chapterId": "ch03"
    },
    {
      "term": "可采纳",
      "def": "启发函数从不高估真实剩余代价的性质。",
      "chapterId": "ch03"
    },
    {
      "term": "A* 搜索",
      "def": "以 g+h 为优先级的最优启发式搜索算法。",
      "chapterId": "ch03"
    },
    {
      "term": "局部搜索",
      "def": "只保留当前状态、在邻居中改进的搜索方法。",
      "chapterId": "ch04"
    },
    {
      "term": "模拟退火",
      "def": "按温度控制的概率接受劣解的随机搜索算法。",
      "chapterId": "ch04"
    },
    {
      "term": "在线搜索",
      "def": "在执行过程中边行动边学习的搜索方式。",
      "chapterId": "ch04"
    },
    {
      "term": "极小化极大",
      "def": "假设对手最优时选择最坏情况最优动作的搜索算法。",
      "chapterId": "ch05"
    },
    {
      "term": "α-β 剪枝",
      "def": "利用已确定边界剪掉不影响结果分支的优化。",
      "chapterId": "ch05"
    },
    {
      "term": "蒙特卡洛树搜索",
      "def": "用大量模拟与 UCB 选择构建博弈树的搜索方法。",
      "chapterId": "ch05"
    },
    {
      "term": "约束满足问题",
      "def": "由变量、值域与约束构成、求满足全部约束赋值的问题。",
      "chapterId": "ch06"
    },
    {
      "term": "弧相容",
      "def": "任何变量的取值都能在邻居中找到相容支持的性质。",
      "chapterId": "ch06"
    },
    {
      "term": "回溯搜索",
      "def": "逐步赋值、冲突则回退的搜索方法。",
      "chapterId": "ch06"
    },
    {
      "term": "蕴含",
      "def": "一个公式在所有满足前提的世界中都为真的关系。",
      "chapterId": "ch07"
    },
    {
      "term": "归结",
      "def": "消去互补文字、从两个子句推出新子句的推理规则。",
      "chapterId": "ch07"
    },
    {
      "term": "可靠性",
      "def": "推理规则只推出真结论的性质。",
      "chapterId": "ch07"
    },
    {
      "term": "完备性",
      "def": "能推出所有被蕴含结论的性质。",
      "chapterId": "ch07"
    },
    {
      "term": "一阶逻辑",
      "def": "引入对象、谓词与量词、能表达关系的逻辑系统。",
      "chapterId": "ch08"
    },
    {
      "term": "量词",
      "def": "表示“所有”或“存在”的符号 ∀ 与 ∃。",
      "chapterId": "ch08"
    },
    {
      "term": "合一",
      "def": "寻找替换使两个表达式相同的算法。",
      "chapterId": "ch08"
    },
    {
      "term": "前向链接",
      "def": "从已知事实出发推出新事实的数据驱动推理。",
      "chapterId": "ch09"
    },
    {
      "term": "反向链接",
      "def": "从目标出发寻找规则前提的目标驱动推理。",
      "chapterId": "ch09"
    },
    {
      "term": "Horn 子句",
      "def": "最多含一个正文字的子句，推理效率高。",
      "chapterId": "ch09"
    },
    {
      "term": "本体论",
      "def": "关于世界由哪些类别构成及其关系的约定体系。",
      "chapterId": "ch10"
    },
    {
      "term": "默认推理",
      "def": "无相反证据时接受默认结论、可被新信息撤回的推理。",
      "chapterId": "ch10"
    },
    {
      "term": "描述逻辑",
      "def": "表达力受限但推理可判定的逻辑片段。",
      "chapterId": "ch10"
    },
    {
      "term": "STRIPS",
      "def": "用前提与添加/删除列表表示动作的规划语言。",
      "chapterId": "ch11"
    },
    {
      "term": "松弛问题",
      "def": "去掉部分约束使问题变易、用于生成启发式的问题。",
      "chapterId": "ch11"
    },
    {
      "term": "分层规划",
      "def": "在抽象层与具体层分别规划再细化的方法。",
      "chapterId": "ch11"
    },
    {
      "term": "条件概率",
      "def": "在给定事件发生时另一事件的概率。",
      "chapterId": "ch12"
    },
    {
      "term": "贝叶斯公式",
      "def": "用似然与先验计算后验的公式。",
      "chapterId": "ch12"
    },
    {
      "term": "条件独立",
      "def": "给定某变量后两变量联合概率等于边缘概率乘积。",
      "chapterId": "ch12"
    },
    {
      "term": "贝叶斯网",
      "def": "用有向无环图与条件概率表表示联合分布的概率模型。",
      "chapterId": "ch13"
    },
    {
      "term": "变量消去",
      "def": "按顺序对变量求和、复用中间因子的精确推理算法。",
      "chapterId": "ch13"
    },
    {
      "term": "似然加权",
      "def": "按证据固定、按先验采样并用权重修正的近似推理方法。",
      "chapterId": "ch13"
    },
    {
      "term": "滤波",
      "def": "根据至今证据估计当前状态后验的推理任务。",
      "chapterId": "ch14"
    },
    {
      "term": "卡尔曼滤波",
      "def": "在线性高斯假设下递归更新均值与协方差的滤波算法。",
      "chapterId": "ch14"
    },
    {
      "term": "粒子滤波",
      "def": "用加权样本近似后验的非参数滤波方法。",
      "chapterId": "ch14"
    },
    {
      "term": "概率编程",
      "def": "用程序写生成过程、由后端自动推断的概率建模方式。",
      "chapterId": "ch15"
    },
    {
      "term": "变分推断",
      "def": "用可优化的简单分布逼近后验的推断方法。",
      "chapterId": "ch15"
    },
    {
      "term": "MCMC",
      "def": "通过长期采样逼近后验分布的推断方法。",
      "chapterId": "ch15"
    },
    {
      "term": "期望效用",
      "def": "在信念分布下某动作带来的效用期望值。",
      "chapterId": "ch16"
    },
    {
      "term": "效用函数",
      "def": "把结果状态映射为偏好程度的函数。",
      "chapterId": "ch16"
    },
    {
      "term": "信息价值",
      "def": "获得某信息后决策改善的期望幅度。",
      "chapterId": "ch16"
    },
    {
      "term": "POMDP",
      "def": "部分可观测马尔可夫决策过程，需在信念空间上决策。",
      "chapterId": "ch17"
    },
    {
      "term": "信念状态",
      "def": "对当前世界状态的概率分布估计。",
      "chapterId": "ch17"
    },
    {
      "term": "风险敏感决策",
      "def": "考虑收益分布尾部而非仅期望的决策方式。",
      "chapterId": "ch17"
    },
    {
      "term": "纳什均衡",
      "def": "无人能通过单方改变策略获益的策略组合。",
      "chapterId": "ch18"
    },
    {
      "term": "零和博弈",
      "def": "一方收益等于另一方损失的博弈。",
      "chapterId": "ch18"
    },
    {
      "term": "机制设计",
      "def": "设计规则使自利行为产生良好集体结果的方法。",
      "chapterId": "ch18"
    },
    {
      "term": "监督学习",
      "def": "从带标签的输入输出对学习映射的方法。",
      "chapterId": "ch19"
    },
    {
      "term": "信息增益",
      "def": "分裂前后熵的减少量。",
      "chapterId": "ch19"
    },
    {
      "term": "归纳偏置",
      "def": "学习器为泛化而预设的偏好假设。",
      "chapterId": "ch19"
    },
    {
      "term": "过拟合",
      "def": "模型拟合训练数据噪声、泛化变差的现象。",
      "chapterId": "ch19"
    },
    {
      "term": "最大似然估计",
      "def": "使观测数据出现概率最大的参数估计。",
      "chapterId": "ch20"
    },
    {
      "term": "最大后验估计",
      "def": "在参数先验下使后验最大的参数估计。",
      "chapterId": "ch20"
    },
    {
      "term": "EM 算法",
      "def": "在含隐变量时交替求后验与更新参数的迭代算法。",
      "chapterId": "ch20"
    },
    {
      "term": "反向传播",
      "def": "用链式法则从输出向输入逐层计算梯度的算法。",
      "chapterId": "ch21"
    },
    {
      "term": "卷积",
      "def": "用共享卷积核在空间上滑动提取局部特征的运算。",
      "chapterId": "ch21"
    },
    {
      "term": "注意力机制",
      "def": "按查询与键的相似度对值加权聚合的机制。",
      "chapterId": "ch21"
    },
    {
      "term": "梯度消失",
      "def": "深层网络中梯度逐层衰减导致浅层难以训练的现象。",
      "chapterId": "ch21"
    },
