      "chapterId": "ch01",
      "front": "版本空间怎么得到？",
      "back": "用训练集删掉所有预测不符的假设，剩下的就是。",
      "tags": [
        "concept"
      ]
    },
    {
      "id": "f03",
      "chapterId": "ch01",
      "front": "NFL 定理的真正含义？",
      "back": "脱离问题结构谈算法优劣没有意义。",
      "tags": [
        "theory"
      ]
    },
    {
      "id": "f04",
      "chapterId": "ch02",
      "front": "查准率与查全率的公式？",
      "back": "P=TP/(TP+FP)，R=TP/(TP+FN)。",
      "tags": [
        "metric"
      ]
    },
    {
      "id": "f05",
      "chapterId": "ch02",
      "front": "F1 为什么用调和平均？",
      "back": "对较小的一项更敏感，能暴露短板。",
      "tags": [
        "metric"
      ]
    },
    {
      "id": "f06",
      "chapterId": "ch02",
      "front": "k 折交叉验证的 k 常取多少？",
      "back": "5 或 10，兼顾计算量与偏差。",
      "tags": [
        "evaluation"
      ]
    },
    {
      "id": "f07",
      "chapterId": "ch02",
      "front": "AUC 为什么在样本不平衡时更稳？",
      "back": "它衡量排序能力，不依赖阈值和类别比例。",
      "tags": [
        "metric"
      ]
    },
    {
      "id": "f08",
      "chapterId": "ch02",
      "front": "36.8% 的由来？",
      "back": "(1-1/m)^m 极限为 1/e。",
      "tags": [
        "evaluation"
      ]
    },
    {
      "id": "f09",
      "chapterId": "ch03",
      "front": "最小二乘闭式解？",
      "back": "w=(XᵀX)^{-1}Xᵀy；奇异时加 λI 得岭回归。",
      "tags": [
        "linear"
      ]
    },
    {
      "id": "f10",
      "chapterId": "ch03",
      "front": "对数几率回归损失为什么用交叉熵？",
      "back": "梯度化简为 ŷ-y，不因 sigmoid 饱和而消失。",
      "tags": [
        "linear"
      ]
    },
    {
      "id": "f11",
      "chapterId": "ch03",
      "front": "OvO 与 OvR 的模型数量？",
      "back": "OvO 需 k(k-1)/2 个；OvR 需 k 个。",
      "tags": [
        "multiclass"
      ]
    },
    {
      "id": "f12",
      "chapterId": "ch03",
      "front": "阈值移动怎么处理不平衡？",
      "back": "按 p/(1-p) 与负正样本比例比较，而非固定 0.5。",
      "tags": [
        "imbalance"
      ]
    },
    {
      "id": "f13",
      "chapterId": "ch04",
      "front": "信息熵公式？",
      "back": "Ent=-Σ p_k log2 p_k。",
      "tags": [
        "tree"
      ]
    },
    {
      "id": "f14",
      "chapterId": "ch04",
      "front": "信息增益为什么偏向多值特征？",
      "back": "多值特征把数据切得更碎，子集熵更容易接近 0。",
      "tags": [
        "tree"
      ]
    },
    {
      "id": "f15",
      "chapterId": "ch04",
      "front": "基尼指数含义？",
      "back": "随机抽两个样本类别不一致的概率，1-Σp_k²。",
      "tags": [
        "tree"
      ]
    },
    {
      "id": "f16",
      "chapterId": "ch04",
      "front": "预剪枝与后剪枝的风险？",
      "back": "预剪枝易欠拟合；后剪枝计算代价大但泛化更好。",
      "tags": [
        "tree"
      ]
    },
    {
      "id": "f17",
      "chapterId": "ch04",
      "front": "连续值怎么处理？",
      "back": "排序后取相邻值中点作候选划分点，选增益最大者。",
      "tags": [
        "tree"
      ]
    },
    {
      "id": "f18",
      "chapterId": "ch05",
      "front": "单隐层网络的万能近似说明什么？",
      "back": "足够多神经元可逼近任意连续函数，但只保证存在性。",
      "tags": [
        "nn"
      ]
    },
    {
      "id": "f19",
      "chapterId": "ch05",
      "front": "反向传播两个核心步骤？",
      "back": "误差项乘以转置权重回传，再乘本层激活导数。",
      "tags": [
        "nn"
      ]
    },
    {
      "id": "f20",
      "chapterId": "ch05",
      "front": "sigmoid 与 ReLU 的初始化分别用什么？",
      "back": "Xavier（1/√n）与 He（√(2/n)）。",
      "tags": [
        "init"
      ]
    },
    {
      "id": "f21",
      "chapterId": "ch05",
      "front": "跳出局部极小的常用手段？",
      "back": "多初始化、动量、SGD 噪声、模拟退火。",
      "tags": [
        "optimization"
      ]
    },
    {
      "id": "f22",
      "chapterId": "ch06",
      "front": "SVM 的目标函数？",
      "back": "min ½||w||² s.t. y_i(wᵀx_i+b)≥1。",
      "tags": [
        "svm"
      ]
    },
    {
      "id": "f23",
      "chapterId": "ch06",
      "front": "支持向量的判定条件？",
      "back": "对偶解中 α_i>0 的样本，位于间隔边界上。",
      "tags": [
        "svm"
      ]
    },
    {
      "id": "f24",
      "chapterId": "ch06",
      "front": "核技巧的核心思想？",
      "back": "只在对偶中用核函数算内积，不显式构造高维映射。",
      "tags": [
        "kernel"
      ]
    },
    {
      "id": "f25",
      "chapterId": "ch06",
      "front": "软间隔中 C 的作用？",
      "back": "C 大惩罚违规重、间隔窄易过拟合；C 小更宽容。",
      "tags": [
        "svm"
      ]
    },
    {
      "id": "f26",
      "chapterId": "ch07",
      "front": "贝叶斯决策规则？",
      "back": "argmax_c P(c)P(x|c)，P(x) 可忽略。",
      "tags": [
        "bayes"
      ]
    },
    {
      "id": "f27",
      "chapterId": "ch07",
      "front": "朴素贝叶斯的独立性假设？",
      "back": "给定类别下各特征条件独立，P(x|c)=ΠP(x_i|c)。",
      "tags": [
        "bayes"
      ]
    },
    {
      "id": "f28",
      "chapterId": "ch07",
      "front": "拉普拉斯修正公式？",
      "back": "P=(count+1)/(N_c+N_i)。",
      "tags": [
        "bayes"
      ]
    },
    {
      "id": "f29",
      "chapterId": "ch07",
      "front": "EM 两步各做什么？",
      "back": "E 步估计隐变量期望，M 步用补全数据更新参数。",
      "tags": [
        "em"
      ]
    },
    {
      "id": "f30",
      "chapterId": "ch08",
      "front": "Boosting 与 Bagging 的误差分解分工？",
      "back": "Boosting 降偏差，Bagging 降方差。",
      "tags": [
        "ensemble"
      ]
    },
    {
      "id": "f31",
      "chapterId": "ch08",
      "front": "AdaBoost 的 α 公式？",
      "back": "α=½ln((1-ε)/ε)。",
      "tags": [
        "adaboost"
      ]
    },
    {
      "id": "f32",
      "chapterId": "ch08",
      "front": "AdaBoost 样本权重怎么更新？",
      "back": "判错乘 e^α，判对乘 e^-α，再归一化。",
      "tags": [
        "adaboost"
      ]
    },
    {
      "id": "f33",
      "chapterId": "ch08",
      "front": "随机森林的两处随机？",
      "back": "样本自助采样 + 每次分裂随机抽特征子集。",
      "tags": [
        "rf"
      ]
    },
    {
      "id": "f34",
      "chapterId": "ch08",
      "front": "Stacking 为什么要交叉验证？",
      "back": "避免初级输出在训练集上过拟合，导致次级学到假信号。",
      "tags": [
        "stacking"
      ]
    },
    {
      "id": "f35",
      "chapterId": "ch09",
      "front": "k-means 的两步？",
      "back": "分配每个点到最近中心；把中心更新为所属点均值。",
      "tags": [
        "clustering"
      ]
    },
    {
      "id": "f36",
      "chapterId": "ch09",
      "front": "k-means 为什么局部最优？",
      "back": "目标非凸，结果依赖初值；k-means++ 可改善。",
      "tags": [
        "clustering"
      ]
    },
    {
      "id": "f37",
      "chapterId": "ch09",
      "front": "DBSCAN 的两个参数？",
      "back": "半径 ε 与最小点数 MinPts。",
      "tags": [
        "dbscan"
      ]
    },
    {
      "id": "f38",
      "chapterId": "ch09",
      "front": "轮廓系数公式？",
      "back": "s=(b-a)/max(a,b)，a 簇内平均距离，b 最近他簇平均距离。",
      "tags": [
        "metric"
      ]
    },
    {
      "id": "f39",
      "chapterId": "ch10",
      "front": "PCA 的三个步骤？",
      "back": "中心化、算协方差矩阵、特征分解取大特征值方向。",
      "tags": [
        "pca"
      ]
    },
    {
      "id": "f40",
      "chapterId": "ch10",
      "front": "累计贡献率怎么算？",
      "back": "前 d 个特征值之和除以全部特征值之和。",
      "tags": [
        "pca"
      ]
    },
    {
      "id": "f41",
      "chapterId": "ch10",
      "front": "维度灾难的后果？",
      "back": "空间变稀疏，任意两点距离趋同，最近邻失效。",
      "tags": [
        "curse"
      ]
    },
    {
      "id": "f42",
      "chapterId": "ch10",
      "front": "Isomap 与 PCA 的区别？",
      "back": "Isomap 用近邻图最短路近似测地距离，PCA 只看欧氏方差。",
      "tags": [
        "manifold"
      ]
    },
    {
      "id": "f43",
      "chapterId": "ch11",
      "front": "三种特征选择范式？",
      "back": "过滤式看统计量、包裹式看模型性能、嵌入式训练中置零。",
      "tags": [
        "feature"
      ]
    },
    {
      "id": "f44",
      "chapterId": "ch11",
      "front": "Relief 的权重更新公式？",
      "back": "δ_j=-diff(同类近邻)²+diff(异类近邻)²。",
      "tags": [
        "relief"
      ]
    },
    {
      "id": "f45",
      "chapterId": "ch11",
      "front": "L1 为什么稀疏？",
      "back": "菱形等值线顶点在坐标轴上，最优点常落在顶点。",
      "tags": [
        "l1"
      ]
    },
    {
      "id": "f46",
      "chapterId": "ch11",
      "front": "L1 与 L2 在相关特征上的差异？",
      "back": "L1 随机保留一个，L2 平摊权重。",
      "tags": [
        "regularization"
      ]
    },
    {
      "id": "f47",
      "chapterId": "ch12",
      "front": "PAC 的三要素？",
      "back": "误差 ε、失败概率 δ、样本复杂度 m。",
      "tags": [
        "theory"
      ]
    },
    {
      "id": "f48",
      "chapterId": "ch12",
      "front": "打散是什么意思？",
      "back": "一组样本的所有 2^m 种标注都能被假设空间实现。",
      "tags": [
        "vc"
      ]
    },
    {
      "id": "f49",
      "chapterId": "ch12",
      "front": "泛化上界的结构？",
      "back": "训练误差 + 与复杂度成正比、与 √样本量成反比的惩罚项。",
      "tags": [
        "theory"
      ]
    },
    {
      "id": "f50",
      "chapterId": "ch12",
      "front": "稳定性路径与 VC 路径的差别？",
      "back": "稳定性利用算法本身的性质，VC 利用假设空间容量。",
      "tags": [
        "theory"
      ]
    },
    {
      "id": "f51",
      "chapterId": "ch13",
      "front": "半监督的两个基本假设？",
      "back": "聚类假设（边界穿过稀疏区）与流形假设（近邻标签相似）。",
      "tags": [
        "semi"
      ]
    },
    {
      "id": "f52",
      "chapterId": "ch13",
      "front": "纯半监督与直推的差别？",
      "back": "前者要泛化到新样本，后者只标当前无标样本。",
      "tags": [
        "semi"
      ]
    },
    {
      "id": "f53",
      "chapterId": "ch13",
      "front": "图半监督怎么给无标样本定标签？",
      "back": "标签沿相似度边扩散，由邻居加权决定。",
      "tags": [
        "graph"
      ]
    },
    {
      "id": "f54",
      "chapterId": "ch13",
      "front": "协同训练为什么要求视图独立？",
      "back": "否则一个分类器的错误会被另一个复制。",
      "tags": [
        "cotraining"
      ]
    },
    {
      "id": "f55",
      "chapterId": "ch14",
      "front": "贝叶斯网的分解公式？",
      "back": "P(X)=Π P(X_i|parents(X_i))。",
      "tags": [
        "pgm"
      ]
    },
    {
      "id": "f56",
      "chapterId": "ch14",
      "front": "三种基本结构及独立性？",
      "back": "顺连给定中间独立；分连给定中间独立、不给则相关；汇连不给独立、给了相关。",
      "tags": [
        "pgm"
      ]
    },
    {
      "id": "f57",
      "chapterId": "ch14",
      "front": "MRF 的配分函数 Z 作用？",
      "back": "保证势函数乘积归一化为概率。",
      "tags": [
        "pgm"
      ]
    },
    {
      "id": "f58",
      "chapterId": "ch14",
      "front": "MCMC 的 Gibbs 采样怎么做？",
      "back": "每次按其余变量的条件分布更新一个变量。",
      "tags": [
        "inference"
      ]
    },
    {
      "id": "f59",
      "chapterId": "ch14",
      "front": "LDA 的生成过程？",
      "back": "文档抽主题分布，词先抽主题再抽词。",
      "tags": [
        "lda"
      ]
    },
    {
      "id": "f60",
      "chapterId": "ch15",
      "front": "规则的精度与覆盖度分别指？",
      "back": "精度=覆盖样本中正例比例；覆盖度=覆盖的正例数量。",
      "tags": [
        "rule"
      ]
    },
    {
      "id": "f61",
      "chapterId": "ch15",
      "front": "序贯覆盖的流程？",
      "back": "贪心加条件至精度达标，产规则，删覆盖正例，重复。",
      "tags": [
        "rule"
      ]
    },
    {
      "id": "f62",
      "chapterId": "ch15",
      "front": "规则剪枝两种做法？",
      "back": "预剪枝加条件时看验证集；后剪枝长完再删条件。",
      "tags": [
        "rule"
      ]
    },
    {
      "id": "f63",
      "chapterId": "ch15",
      "front": "ILP 相比命题规则的优势？",
      "back": "可用一阶逻辑与背景知识表达关系甚至递归概念。",
      "tags": [
        "ilp"
      ]
    },
    {
      "id": "f64",
      "chapterId": "ch16",
      "front": "强化学习与监督学习的三个不同？",
      "back": "无即时标签、数据自产、探索改变数据分布。",
      "tags": [
        "rl"
      ]
    },
    {
      "id": "f65",
      "chapterId": "ch16",
      "front": "ε-贪心策略？",
      "back": "以 ε 随机探索，1-ε 选当前估计最优动作。",
      "tags": [
        "bandit"
      ]
    },
    {
      "id": "f66",
      "chapterId": "ch16",
      "front": "贝尔曼方程一句话？",
      "back": "当前价值等于即时奖励加折扣后的下一状态价值。",
      "tags": [
        "mdp"
      ]
    },
    {
      "id": "f67",
      "chapterId": "ch16",
      "front": "Q-learning 更新式？",
      "back": "Q(s,a)←Q(s,a)+α[r+γmax Q(s',a')-Q(s,a)]。",
      "tags": [
        "td"
      ]
    },
    {
      "id": "f68",
      "chapterId": "ch16",
      "front": "γ 的作用？",
      "back": "折扣因子，控制视野长度并保证无穷和收敛。",
      "tags": [
        "mdp"
      ]
    }
  ],
  "companion": "zhou-ml学习伴侣.html"
}