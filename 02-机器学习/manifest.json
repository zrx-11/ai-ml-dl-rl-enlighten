  "glossary": [
    {
      "term": "假设空间",
      "def": "所有可能的从特征到标记的映射组成的集合。",
      "chapterId": "ch01"
    },
    {
      "term": "版本空间",
      "def": "假设空间中与训练集完全一致的那部分假设。",
      "chapterId": "ch01"
    },
    {
      "term": "归纳偏好",
      "def": "算法在多个同样符合数据的假设中做选择时依据的先验倾向。",
      "chapterId": "ch01"
    },
    {
      "term": "没有免费午餐定理",
      "def": "在所有可能问题上平均，任何算法的期望性能相同。",
      "chapterId": "ch01"
    },
    {
      "term": "留出法",
      "def": "把数据集按比例切成训练集与测试集。",
      "chapterId": "ch02"
    },
    {
      "term": "交叉验证",
      "def": "把数据分 k 份轮流做测试集，取平均性能。",
      "chapterId": "ch02"
    },
    {
      "term": "自助法",
      "def": "有放回采样构造训练集，未被抽到的样本作测试。",
      "chapterId": "ch02"
    },
    {
      "term": "查准率",
      "def": "预测为正的样本中真正为正的比例。",
      "chapterId": "ch02"
    },
    {
      "term": "查全率",
      "def": "真实正例中被找出来的比例。",
      "chapterId": "ch02"
    },
    {
      "term": "AUC",
      "def": "ROC 曲线下面积，等于正例得分高于负例的概率。",
      "chapterId": "ch02"
    },
    {
      "term": "最小二乘",
      "def": "以平方误差为损失、可用闭式解求解的线性回归方法。",
      "chapterId": "ch03"
    },
    {
      "term": "对数几率回归",
      "def": "用 sigmoid 把线性分数映射为概率的二分类模型。",
      "chapterId": "ch03"
    },
    {
      "term": "OvO",
      "def": "每两个类训练一个分类器的多分类策略。",
      "chapterId": "ch03"
    },
    {
      "term": "OvR",
      "def": "每个类训练一个“是否为本类”分类器的多分类策略。",
      "chapterId": "ch03"
    },
    {
      "term": "类别不平衡",
      "def": "不同类别样本数量差异悬殊，导致模型偏向多数类。",
      "chapterId": "ch03"
    },
    {
      "term": "信息熵",
      "def": "衡量样本集合类别混杂程度的量，越小越纯。",
      "chapterId": "ch04"
    },
    {
      "term": "信息增益",
      "def": "用某特征分裂后熵的下降量。",
      "chapterId": "ch04"
    },
    {
      "term": "增益率",
      "def": "信息增益除以特征固有值，用于惩罚多值特征。",
      "chapterId": "ch04"
    },
    {
      "term": "基尼指数",
      "def": "随机抽两个样本类别不一致的概率。",
      "chapterId": "ch04"
    },
    {
      "term": "剪枝",
      "def": "去掉决策树中泛化收益为负的分支，分预剪枝与后剪枝。",
      "chapterId": "ch04"
    },
    {
      "term": "误差项",
      "def": "损失对本层线性输出的偏导，反向传播中逐层回传的量。",
      "chapterId": "ch05"
    },
    {
      "term": "万能近似定理",
      "def": "足够宽的单隐层网络可任意精度逼近连续函数。",
      "chapterId": "ch05"
    },
    {
      "term": "梯度消失",
      "def": "多层连乘小导数导致浅层梯度趋近于 0。",
      "chapterId": "ch05"
    },
    {
      "term": "局部极小",
      "def": "参数空间中比邻域都低但非全局最低的点。",
      "chapterId": "ch05"
    },
    {
      "term": "支持向量",
      "def": "决定分类边界的少数样本，对偶解中 α 非零。",
      "chapterId": "ch06"
    },
    {
      "term": "间隔",
      "def": "分界面到最近样本的距离，SVM 要最大化它。",
      "chapterId": "ch06"
    },
    {
      "term": "核函数",
      "def": "直接给出高维映射后内积的函数，避免显式映射。",
      "chapterId": "ch06"
    },
    {
      "term": "软间隔",
      "def": "允许部分样本违规的 SVM 形式，用松弛变量与惩罚系数 C 控制。",
      "chapterId": "ch06"
    },
    {
      "term": "贝叶斯最优分类器",
      "def": "已知真实分布时按后验最大决策、错误率最小的分类器。",
      "chapterId": "ch07"
    },
    {
      "term": "朴素贝叶斯",
      "def": "假设特征在给定类别下条件独立的贝叶斯分类器。",
      "chapterId": "ch07"
    },
    {
      "term": "拉普拉斯修正",
      "def": "分子加一、分母加取值数，避免零概率的平滑手段。",
      "chapterId": "ch07"
    },
    {
      "term": "EM 算法",
      "def": "交替估计隐变量与参数、使似然单调不减的迭代算法。",
      "chapterId": "ch07"
    },
    {
      "term": "Boosting",
      "def": "串行训练多个基学习器、每轮聚焦前轮错误样本的集成方法。",
      "chapterId": "ch08"
    },
    {
      "term": "Bagging",
      "def": "自助采样并行训练多个基学习器再投票的集成方法。",
      "chapterId": "ch08"
    },
    {
      "term": "AdaBoost",
      "def": "通过样本权重与学习器权重迭代调整的 Boosting 代表算法。",
      "chapterId": "ch08"
    },
    {
      "term": "随机森林",
      "def": "以决策树为基学习器、引入样本与特征双重随机的 Bagging 集成。",
      "chapterId": "ch08"
    },
    {
      "term": "Stacking",
      "def": "用初级学习器输出训练次级学习器的集成策略。",
      "chapterId": "ch08"
    },
    {
      "term": "聚类",
      "def": "无标签情况下按相似度把样本分组的任务。",
      "chapterId": "ch09"
    },
    {
      "term": "k-means",
      "def": "以平方距离和为目标、交替分配与更新中心的聚类算法。",
      "chapterId": "ch09"
    },
    {
      "term": "DBSCAN",
      "def": "基于密度连通性的聚类算法，能识别噪声与任意形状簇。",
      "chapterId": "ch09"
    },
    {
      "term": "轮廓系数",
      "def": "衡量簇内紧密度与簇间分离度的指标。",
      "chapterId": "ch09"
    },
    {
      "term": "维度灾难",
      "def": "维度升高导致样本稀疏、距离度量失效的现象。",
      "chapterId": "ch10"
    },
    {
      "term": "PCA",
      "def": "以最大化投影方差为目标的主成分分析降维方法。",
      "chapterId": "ch10"
    },
    {
      "term": "累计贡献率",
      "def": "保留的主成分特征值之和占全部特征值和的比例。",
      "chapterId": "ch10"
    },
    {
      "term": "流形学习",
      "def": "假设数据位于低维流形并保持其局部或全局结构的降维方法。",
      "chapterId": "ch10"
    },
    {
      "term": "特征选择",
      "def": "从原始特征中挑出对任务有用的子集。",
      "chapterId": "ch11"
    },
    {
      "term": "Relief",
      "def": "用同类与异类最近邻的距离差给特征打分的过滤式方法。",
      "chapterId": "ch11"
    },
    {
      "term": "L1 正则",
      "def": "权重绝对值之和作惩罚项，倾向于产生稀疏解。",
      "chapterId": "ch11"
    },
    {
      "term": "稀疏表示",
      "def": "用少量非零系数表示样本，兼顾压缩与可解释性。",
      "chapterId": "ch11"
    },
    {
      "term": "PAC",
      "def": "在高概率下输出误差不超过给定界的假设的学习框架。",
      "chapterId": "ch12"
    },
    {
      "term": "VC 维",
      "def": "假设空间能打散的最大样本集大小。",
      "chapterId": "ch12"
    },
    {
      "term": "泛化误差上界",
      "def": "用训练误差与模型复杂度、样本量给出的泛化性能界。",
      "chapterId": "ch12"
    },
    {
      "term": "算法稳定性",
      "def": "训练集微扰导致输出模型损失变化有限的性質。",
      "chapterId": "ch12"
    },
    {
      "term": "半监督学习",
      "def": "同时利用少量有标与大量无标数据训练模型。",
      "chapterId": "ch13"
    },
    {
      "term": "聚类假设",
      "def": "决策边界应穿过数据低密度区域。",
      "chapterId": "ch13"
    },
    {
      "term": "流形假设",
      "def": "相邻样本位于同一低维流形，标记应相似。",
      "chapterId": "ch13"
    },
    {
      "term": "直推学习",
      "def": "只对给定的一批未标注样本做预测，不追求泛化。",
      "chapterId": "ch13"
    },
    {
      "term": "贝叶斯网",
      "def": "用有向无环图表示变量间条件依赖的概率模型。",
      "chapterId": "ch14"
    },
    {
      "term": "马尔可夫随机场",
      "def": "用无向图与团势函数表示联合分布的概率模型。",
      "chapterId": "ch14"
    },
    {
      "term": "d-分离",
      "def": "判断贝叶斯网中两变量在给定证据下是否条件独立的图准则。",
      "chapterId": "ch14"
    },
    {
      "term": "配分函数",
      "def": "使无向图模型势函数乘积归一化为概率分布的常数。",
      "chapterId": "ch14"
    },
    {
      "term": "LDA",
      "def": "以文档-主题-词三层生成结构建模文本主题的概率模型。",
      "chapterId": "ch14"
    },
    {
      "term": "序贯覆盖",
      "def": "一条条生成规则、每轮删掉已覆盖正例的规则学习策略。",
      "chapterId": "ch15"
    },
    {
      "term": "精度",
      "def": "规则覆盖的样本中正例所占比例。",
      "chapterId": "ch15"
    },
    {
      "term": "覆盖度",
      "def": "规则覆盖的正例数量。",
      "chapterId": "ch15"
    },
    {
      "term": "归纳逻辑程序设计",
      "def": "用一阶逻辑表示规则并引入背景知识的规则学习框架。",
      "chapterId": "ch15"
    },
    {
      "term": "强化学习",
      "def": "智能体通过与环境交互、以最大化长期累积奖励为目标的学习范式。",
      "chapterId": "ch16"
    },
    {
      "term": "ε-贪心",
      "def": "以 ε 概率随机探索、否则选当前最优动作的策略。",
      "chapterId": "ch16"
    },
    {
      "term": "马尔可夫决策过程",
