  "audience": "大一：会微积分与概率基础，线性代数需补",
  "goal": "能对任意一个监督学习算法说清它优化什么目标、为什么这样优化、失败时怎么诊断",
  "learningPath": [
    {
      "step": "01",
      "title": "问题设定与假设空间",
      "chapterIds": [
        "ch01"
      ],
      "prereq": "无",
      "checkpoint": "能用自己的话解释版本空间与 NFL",
      "goal": "建立“学习=在假设空间里筛选”的框架"
    },
    {
      "step": "02",
      "title": "评估与选择",
      "chapterIds": [
        "ch02"
      ],
      "prereq": "ch01",
      "checkpoint": "给定混淆矩阵算出 P、R、F1，并说明为何要显著性检验",
      "goal": "能设计一套可信的评估流程"
    },
    {
      "step": "03",
      "title": "线性模型",
      "chapterIds": [
        "ch03"
      ],
      "prereq": "ch02、矩阵求导",
      "checkpoint": "推出最小二乘闭式解并解释为何用交叉熵",
      "goal": "掌握最基础的判别模型"
    },
    {
      "step": "04",
      "title": "决策树",
      "chapterIds": [
        "ch04"
      ],
      "prereq": "ch03",
      "checkpoint": "手算一次信息增益与一轮剪枝判断",
      "goal": "理解“用判据贪心分裂”的思路"
    },
    {
      "step": "05",
      "title": "神经网络",
      "chapterIds": [
        "ch05"
      ],
      "prereq": "ch03、ch04",
      "checkpoint": "写出 δ 的回传公式并解释梯度消失",
      "goal": "掌握参数化模型的训练机制"
    },
    {
      "step": "06",
      "title": "支持向量机",
      "chapterIds": [
        "ch06"
      ],
      "prereq": "ch05、拉格朗日",
      "checkpoint": "推出对偶并说明支持向量为何只占少数",
      "goal": "理解间隔最大化与核技巧"
    },
    {
      "step": "07",
      "title": "贝叶斯分类器",
      "chapterIds": [
        "ch07"
      ],
      "prereq": "ch02、概率论",
      "checkpoint": "手算一次朴素贝叶斯分类并说明平滑的作用",
      "goal": "掌握概率视角的分类"
    },
    {
      "step": "08",
      "title": "集成学习",
      "chapterIds": [
        "ch08"
      ],
      "prereq": "ch04、ch06、ch07",
      "checkpoint": "算一轮 AdaBoost 的 α 与权重更新",
      "goal": "理解偏差方差分解与集成分工"
    },
    {
      "step": "09",
      "title": "聚类",
      "chapterIds": [
        "ch09"
      ],
      "prereq": "ch02",
      "checkpoint": "手算一轮 k-means 并用轮廓系数评价",
      "goal": "掌握无监督分组"
    },
    {
      "step": "10",
      "title": "降维与度量学习",
      "chapterIds": [
        "ch10"
      ],
      "prereq": "ch09、线代",
      "checkpoint": "推出 PCA 的最优方向并说明累计贡献率",
      "goal": "掌握维度压缩"
    },
    {
      "step": "11",
      "title": "特征选择与稀疏学习",
      "chapterIds": [
        "ch11"
      ],
      "prereq": "ch03、ch10",
      "checkpoint": "解释 L1 为何稀疏并算一次 Relief 更新",
      "goal": "掌握特征层面的简化"
    },
    {
      "step": "12",
      "title": "计算学习理论",
      "chapterIds": [
        "ch12"
      ],
      "prereq": "ch02、概率不等式",
      "checkpoint": "说明 VC 维与泛化上界的关系",
      "goal": "建立“需要多少数据”的判断"
    },
    {
      "step": "13",
      "title": "半监督学习",
      "chapterIds": [
        "ch13"
      ],
      "prereq": "ch07、ch09",
      "checkpoint": "说明两个假设与三条路线",
      "goal": "掌握少标签场景的处理"
    },
    {
      "step": "14",
      "title": "概率图模型",
      "chapterIds": [
        "ch14"
      ],
      "prereq": "ch07、图论基础",
      "checkpoint": "用 d-分离判断独立性，说明汇连的反直觉",
      "goal": "掌握结构化概率建模"
    },
    {
      "step": "15",
      "title": "规则学习",
      "chapterIds": [
        "ch15"
      ],
      "prereq": "ch04",
      "checkpoint": "描述序贯覆盖流程并说明 ILP 的作用",
      "goal": "掌握可解释的符号方法"
    },
    {
      "step": "16",
      "title": "强化学习（对接专书）",
      "chapterIds": [
        "ch16"
      ],
      "prereq": "ch03、ch07",
      "checkpoint": "写出 Q-learning 更新式并对比 Sarsa",
      "goal": "把监督学习框架扩展到序列决策"
    }
  ],
