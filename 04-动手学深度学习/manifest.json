  "glossary": [
    {
      "term": "端到端训练",
      "def": "从原始输入到最终输出整条流水线一起用梯度优化。",
      "chapterId": "ch01"
    },
    {
      "term": "特征工程",
      "def": "人工设计输入表示的传统做法。",
      "chapterId": "ch01"
    },
    {
      "term": "NDArray",
      "def": "支持 GPU 与自动求导的多维数组结构。",
      "chapterId": "ch02"
    },
    {
      "term": "自动求导",
      "def": "框架记录前向计算图并反向计算梯度的机制。",
      "chapterId": "ch02"
    },
    {
      "term": "条件概率",
      "def": "在事件 B 发生的前提下 A 发生的概率，P(A|B)。",
      "chapterId": "ch02"
    },
    {
      "term": "小批量随机梯度下降",
      "def": "每次用一小批样本估计梯度并更新参数。",
      "chapterId": "ch03"
    },
    {
      "term": "softmax",
      "def": "把一组分数变成和为 1 的概率分布。",
      "chapterId": "ch03"
    },
    {
      "term": "权重衰减",
      "def": "在损失中加入权重平方项抑制过大参数。",
      "chapterId": "ch03"
    },
    {
      "term": "梯度裁剪",
      "def": "梯度范数超阈值时按比例缩放，防止爆炸。",
      "chapterId": "ch03"
    },
    {
      "term": "Module",
      "def": "封装子层、参数与前向逻辑的模型容器。",
      "chapterId": "ch04"
    },
    {
      "term": "超参数",
      "def": "训练前人为设定的配置项，如学习率与层数。",
      "chapterId": "ch04"
    },
    {
      "term": "互相关",
      "def": "核不翻转、直接逐元素乘加的卷积实现。",
      "chapterId": "ch05"
    },
    {
      "term": "感受野",
      "def": "输出中一个元素对应的输入区域大小。",
      "chapterId": "ch05"
    },
    {
      "term": "1×1 卷积",
      "def": "核大小为 1、只在通道维做线性组合的卷积。",
      "chapterId": "ch05"
    },
    {
      "term": "LeNet",
      "def": "最早的卷积网络之一，用于手写数字识别。",
      "chapterId": "ch05"
    },
    {
      "term": "循环神经网络",
      "def": "带隐状态、在时间维共享参数的序列模型。",
      "chapterId": "ch06"
    },
    {
      "term": "通过时间反向传播",
      "def": "把 RNN 按时间展开后做反向传播的算法。",
      "chapterId": "ch06"
    },
    {
      "term": "门控循环单元",
      "def": "用重置门与更新门控制信息流的简化门控 RNN。",
      "chapterId": "ch06"
    },
    {
      "term": "长短期记忆",
      "def": "引入细胞状态与三个门的门控 RNN，缓解梯度消失。",
      "chapterId": "ch06"
    },
    {
      "term": "动量法",
      "def": "累积历史梯度方向以加速一致维度、抑制震荡的优化方法。",
      "chapterId": "ch07"
    },
    {
      "term": "AdaGrad",
      "def": "按历史梯度平方和自适应缩小各维步长的算法。",
      "chapterId": "ch07"
    },
    {
      "term": "Adam",
      "def": "结合一阶矩与二阶矩估计并做偏置修正的自适应优化器。",
      "chapterId": "ch07"
    },
    {
      "term": "学习率调度",
      "def": "按训练进度调整学习率的策略。",
      "chapterId": "ch07"
    },
    {
      "term": "数据并行",
      "def": "每卡一份模型、数据分片的并行训练方式。",
      "chapterId": "ch08"
    },
    {
      "term": "模型并行",
      "def": "把模型切分到多卡的并行训练方式。",
      "chapterId": "ch08"
    },
    {
      "term": "梯度累积",
      "def": "多次小批量累积梯度后再更新，等效增大批大小。",
      "chapterId": "ch08"
    },
    {
      "term": "图像增广",
      "def": "通过翻转裁剪变色等变换扩大训练分布的正则手段。",
      "chapterId": "ch09"
    },
    {
      "term": "微调",
      "def": "在预训练模型上替换输出层并以小学习率继续训练。",
      "chapterId": "ch09"
    },
    {
      "term": "IoU",
      "def": "两个框交集与并集的面积比。",
      "chapterId": "ch09"
    },
    {
      "term": "锚框",
      "def": "预设的参考框，模型预测相对它的偏移与类别。",
      "chapterId": "ch09"
    },
    {
      "term": "非极大值抑制",
      "def": "按分数抑制重叠检测框的后处理算法。",
      "chapterId": "ch09"
    },
    {
      "term": "风格迁移",
      "def": "用内容损失与风格损失优化生成图像的技术。",
      "chapterId": "ch09"
    },
    {
      "term": "词嵌入",
      "def": "把离散词映射为稠密向量以表达语义相似性。",
      "chapterId": "ch10"
    },
    {
      "term": "负采样",
      "def": "用少量随机负例替代全词表归一化的训练加速技巧。",
      "chapterId": "ch10"
    },
    {
      "term": "注意力机制",
      "def": "按相关性对序列各位置加权求和的信息聚合方式。",
      "chapterId": "ch10"
    },
    {
      "term": "自注意力",
      "def": "序列内部各位置相互计算相关性的注意力形式。",
      "chapterId": "ch10"
    },
    {
      "term": "位置编码",
      "def": "为无顺序感知的模型注入位置信息的向量。",
      "chapterId": "ch10"
    },
    {
      "term": "范数",
      "def": "衡量向量长度的函数，常用 L1 与 L2。",
      "chapterId": "ch11"
    },
    {
      "term": "DataLoader",
      "def": "负责批处理、打乱与并行加载数据的工具。",
      "chapterId": "ch11"
    }
  ],
